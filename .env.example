KAFKA_TOPIC=retail-rocket-events
CSV_PATH=/app/data/events_sorted.csv
# Chỉ đổi SO_DONG rồi chạy: sh scripts/demo.sh start
SO_DONG=500
# scripts/demo.sh start đặt LIMIT=SO_DONG; LIMIT này chỉ dùng khi gọi Compose trực tiếp.
LIMIT=
SKIP=0
SPEEDUP=20
MAX_SLEEP=5
RATE=10
PROGRESS_EVERY=100
SHUTDOWN_TIMEOUT=15
REORDER_BUFFER=0
REORDER_SEED=7
STARTING_OFFSETS=earliest
WINDOW_DURATION=10 minutes
SLIDE_DURATION=5 minutes
WATERMARK=5 minutes
SESSION_GAP=30 minutes
TRIGGER_SECONDS=5
INTENT_THRESHOLD=5
MAX_OFFSETS_PER_TRIGGER=0
# scripts/demo.sh start tự tạo OUTPUT_HOST_DIR mới; giá trị này dùng khi gọi Compose trực tiếp.
OUTPUT_HOST_DIR=../output
ARCHIVE_RAW_EVENTS=1

